{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "name/cos:GetService"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "name/cos:HeadBucket",
        "name/cos:GetBucketLifecycle",
        "name/cos:GetBucketVersioning",
        "name/cos:GetBucketLogging",
        "name/cos:GetBucketInventory",
        "name/cos:ListBucketInventoryConfigurations"
      ],
      "resource": [
        "qcs::cos:*:uid/${appid}:*/*",
        "qcs::cos:*:uid/${appid}:*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "finance:DescribeBill*",
        "finance:DescribeResourceBill*",
        "finance:DescribeDosage*"
      ],
      "resource": [
        "*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "monitor:GetMonitorData"
      ],
      "resource": [
        "*"
      ]
    }
  ]
}
